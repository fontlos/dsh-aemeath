{
  "name": "dsh-aemeath",
  "version": "0.3.0",
  "description": "爱弥斯主题皮肤 + 像素桌宠 + 高级推理强度滑块（鸣潮 Aemeath）：4K 壁纸背景、精灵动画桌宠、Claude 风格推理强度滑块与最高档动画。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "node scripts/build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "files": [
    "assets",
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "skin",
    "pet",
    "effort",
    "model-picker",
    "aemeath",
    "wuthering-waves"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-settings": "0.1.6-alpha.2",
    "@types/node": "^24.13.6",
    "@types/react": "^18.3.31",
    "rolldown": "^1.2.7",
    "typescript": "^6.0.3"
  }
}
