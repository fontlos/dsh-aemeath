{
  "name": "dsh-aemeath",
  "version": "0.2.0",
  "description": "爱弥斯主题皮肤 + 像素桌宠 + 高级推理强度滑块（鸣潮 Aemeath）：4K 壁纸背景、精灵动画桌宠、Claude 风格推理强度滑块与最高档动画。零依赖",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "prepack": "node scripts/build-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": ">=0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "files": [
    "assets",
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "skin",
    "pet",
    "effort",
    "model-picker",
    "aemeath",
    "wuthering-waves"
  ],
  "devDependencies": {
    "rolldown": "^1.2.7"
  }
}
